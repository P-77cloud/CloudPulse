# CloudPulse - Environment Configuration Example

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/cloudpulse
# MongoDB Atlas Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cloudpulse?retryWrites=true&w=majority

# Monitoring Engine Configuration
CLOUDPULSE_SCHEDULER_ENABLED=true
CLOUDPULSE_SCHEDULER_INTERVAL_MS=15000
CLOUDPULSE_DEFAULT_TIMEOUT_MS=5000
CLOUDPULSE_SECURITY_ALLOW_PRIVATE_IPS=false

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
